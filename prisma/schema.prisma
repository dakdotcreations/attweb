// Prisma schema for Altura Tours & Travel.
// Auth tables are shaped for better-auth; business models follow.

generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
}

// ----------------------------------------------------------------------------
// better-auth core tables. Field names must match better-auth's schema.
// "OtpCode" from the spec lives in `Verification` (identifier = "sign-in-otp-<email>").
// ----------------------------------------------------------------------------

model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          UserRole   @default(EDITOR)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  uploads       Media[]
  blogPosts     BlogPost[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ----------------------------------------------------------------------------
// Media library (Azure Blob). Every image has a full-size blob and a thumbnail.
// ----------------------------------------------------------------------------

model Media {
  id              String  @id @default(cuid())
  /// Blob path of the full image, e.g. "media/2026/11/<id>.webp"
  blobKey         String  @unique
  url             String
  thumbBlobKey    String  @unique
  thumbUrl        String
  /// Original file name as uploaded (for search/display)
  filename        String
  mimeType        String
  /// Size in bytes of the stored full image
  size            Int
  width           Int
  height          Int
  /// Whether the upload was compressed/optimized with sharp
  compressed      Boolean
  alt             String  @default("")
  caption         String?
  /// Shown on the public Gallery page
  showInGallery   Boolean @default(false)
  galleryCategory String?
  uploadedById    String?
  uploadedBy      User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  // Where the image is used. Deleting media clears covers (SetNull) and removes it from galleries (Cascade).
  serviceCovers  Service[]             @relation("ServiceCover")
  packageCovers  TourPackage[]         @relation("PackageCover")
  packageGallery PackageGalleryImage[]
  blogCovers     BlogPost[]            @relation("BlogCover")
  testimonials   Testimonial[]         @relation("TestimonialPhoto")
  siteOgImage    SiteSettings[]        @relation("SiteOgImage")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([showInGallery, createdAt])
  @@index([createdAt])
  @@map("media")
}

// ----------------------------------------------------------------------------
// Content
// ----------------------------------------------------------------------------

enum PublishStatus {
  DRAFT
  PUBLISHED
}

/// A business line (Wildlife Tours, Gorilla Trekking, Medical Tourism, ...).
/// Also used as a category tag on tour packages (many-to-many).
model Service {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  /// One or two sentences for cards and meta descriptions
  summary        String           @default("")
  /// Rich text (sanitized HTML)
  content        String           @default("")
  coverImageId   String?
  coverImage     Media?           @relation("ServiceCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  status         PublishStatus    @default(DRAFT)
  sortOrder      Int              @default(0)
  seoTitle       String?
  seoDescription String?
  packages       PackageService[]
  blogPosts      BlogPost[]
  testimonials   Testimonial[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, sortOrder])
  @@map("service")
}

model TourPackage {
  id             String                @id @default(cuid())
  slug           String                @unique
  title          String
  summary        String                @default("")
  /// Rich text (sanitized HTML) overview. No day-by-day itinerary by design.
  description    String                @default("")
  durationDays   Int
  durationNights Int?
  location       String?
  coverImageId   String?
  coverImage     Media?                @relation("PackageCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  featured       Boolean               @default(false)
  status         PublishStatus         @default(DRAFT)
  sortOrder      Int                   @default(0)
  seoTitle       String?
  seoDescription String?
  services       PackageService[]
  prices         PackagePrice[]
  highlights     TourHighlight[]
  inclusions     TourInclusion[]
  exclusions     TourExclusion[]
  gallery        PackageGalleryImage[]
  testimonials   Testimonial[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, featured, sortOrder])
  @@map("tour_package")
}

/// Service tags on a package.
model PackageService {
  packageId String
  package   TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([packageId, serviceId])
  @@index([serviceId])
  @@map("package_service")
}

/// A labeled price tier. Both currencies are set by the business (no conversion); at least one is required.
model PackagePrice {
  id          String      @id @default(cuid())
  packageId   String
  package     TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  /// e.g. "Per person (2 pax)", "Group of 6+"
  label       String
  /// Whole Uganda shillings
  amountUGX   Int?
  /// Whole US dollars
  amountUSD   Int?
  /// Shown as "From ..." on cards; at most one per package
  isFromPrice Boolean     @default(false)
  sortOrder   Int         @default(0)

  @@index([packageId, sortOrder])
  @@map("package_price")
}

model TourHighlight {
  id        String      @id @default(cuid())
  packageId String
  package   TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int         @default(0)

  @@index([packageId, sortOrder])
  @@map("tour_highlight")
}

model TourInclusion {
  id        String      @id @default(cuid())
  packageId String
  package   TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int         @default(0)

  @@index([packageId, sortOrder])
  @@map("tour_inclusion")
}

model TourExclusion {
  id        String      @id @default(cuid())
  packageId String
  package   TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int         @default(0)

  @@index([packageId, sortOrder])
  @@map("tour_exclusion")
}

model PackageGalleryImage {
  packageId String
  package   TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder Int         @default(0)

  @@id([packageId, mediaId])
  @@index([packageId, sortOrder])
  @@map("package_gallery_image")
}

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String        @default("")
  /// Rich text (sanitized HTML)
  content        String        @default("")
  coverImageId   String?
  coverImage     Media?        @relation("BlogCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  /// Optional related service (e.g. a visa guide under Visa Assistance)
  serviceId      String?
  service        Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status         PublishStatus @default(DRAFT)
  /// Set the first time the post is published
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
  @@map("blog_post")
}

model Testimonial {
  id        String        @id @default(cuid())
  name      String
  /// e.g. "Germany" or "Kampala, Uganda"
  location  String?
  quote     String
  /// 1-5, optional
  rating    Int?
  photoId   String?
  photo     Media?        @relation("TestimonialPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  serviceId String?
  service   Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  packageId String?
  package   TourPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  featured  Boolean       @default(false)
  status    PublishStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, featured, sortOrder])
  @@map("testimonial")
}

/// Single row (id = 1) of business-wide settings.
model SiteSettings {
  id             Int      @id @default(1)
  companyName    String   @default("Altura Tours & Travel")
  tagline        String?
  email          String?
  /// Where new inquiry notifications are sent (falls back to email)
  inquiryEmail   String?
  phone          String?
  /// International format, e.g. +256700000000
  whatsappNumber String?
  address        String?
  officeHours    String?
  facebookUrl    String?
  instagramUrl   String?
  tiktokUrl      String?
  youtubeUrl     String?
  linkedinUrl    String?
  tripadvisorUrl String?
  seoTitle       String?
  seoDescription String?
  ogImageId      String?
  ogImage        Media?   @relation("SiteOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  updatedAt      DateTime @updatedAt

  @@map("site_settings")
}
