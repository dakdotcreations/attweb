# Copy to .env and fill in. Variables are validated at startup by src/env.ts.

# --- Database (Railway PostgreSQL) -------------------------------------------
# Railway → your Postgres service → Connect → "Postgres Connection URL"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"

# --- better-auth --------------------------------------------------------------
# Generate with: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=""
# Public base URL of the app (no trailing slash). Production: https://your-domain
BETTER_AUTH_URL="http://localhost:5173"

# --- SMTP (login OTP emails, sent via Nodemailer) ----------------------------
SMTP_HOST="smtp.example.com"
# 587 = STARTTLS (SMTP_SECURE=false), 465 = implicit TLS (SMTP_SECURE=true)
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Altura Tours & Travel <no-reply@example.com>"

# --- Azure Blob Storage (media uploads, public read) -------------------------
# Azure Portal → Storage account → Security + networking → Access keys → Connection string
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
# Lowercase letters, numbers and hyphens. Created automatically (public blob access) if missing.
AZURE_STORAGE_CONTAINER="media"
# Optional: CDN or custom domain in front of the container, e.g. https://cdn.alturatours.com/media
# Leave empty to use the storage account URL.
AZURE_STORAGE_PUBLIC_URL=""

# --- Seed (only used by `pnpm db:seed`, not by the app) ----------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Administrator"
